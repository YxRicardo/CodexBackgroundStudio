{
  "schemaVersion": 1,
  "id": "azure-reverie",
  "displayName": "澄蓝浮光 · Azure Reverie",
  "version": "1.2.0",
  "images": {
    "hero": "assets/hero.png"
  },
  "copy": {
    "tagline": "让灵感随光浮现",
    "signature": "AZURE REVERIE"
  },
  "targets": {
    "codex": {
      "css": "codex.css",
      "options": {
        "rendererProfile": "codex-theme-v1",
        "baseTheme": {
          "mode": "light",
          "codeTheme": "codex",
          "accent": "#6E60B7",
          "contrast": 82,
          "ink": "#203653",
          "surface": "#F0F8FF",
          "opaqueWindows": true,
          "fonts": {
            "windowsCode": "Cascadia Code",
            "windowsUi": "Microsoft YaHei UI",
            "macCode": "SF Mono",
            "macUi": "PingFang SC"
          },
          "semanticColors": {
            "diffAdded": "#D8EFE7",
            "diffRemoved": "#F3DEE8",
            "skill": "#6E60B7"
          }
        }
      },
      "verification": {
        "contexts": [
          {
            "name": "home",
            "when": {
              "any": [
                "[class~=\"[container-name:home-main-content]\"]:has([data-feature=\"game-source\"])"
              ]
            },
            "required": [
              {
                "name": "home-heading",
                "any": [
                  "[data-feature=\"game-source\"]"
                ]
              },
              {
                "name": "home-art-surface",
                "any": [
                  ".dream-home"
                ]
              }
            ]
          }
        ]
      }
    }
  }
}